# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (Production and Preview).
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# never put secrets in them.

# --- Firebase web app (public; Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Local: <project>.firebaseapp.com. Production: your Vercel domain (e.g. yourtube.vercel.app),
# so Google sign-in redirects go through the /__/auth rewrite in next.config.ts.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SECRET; Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The key on one line with literal \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# --- Razorpay (use TEST mode keys: rzp_test_...)
# Not read by the app: the key ID reaches Checkout via /api/payments/create-order.
# Listed for completeness; safe to leave empty.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
# SECRET
RAZORPAY_KEY_SECRET=
# SECRET; the value you enter when creating the webhook in the Razorpay dashboard
# (event payment.captured, URL https://<domain>/api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Gmail SMTP with an App Password; needs 2-Step Verification)
SMTP_USER=
# SECRET: 16-character App Password, no spaces
SMTP_PASS=
MAIL_FROM="YourTube <you@gmail.com>"

# --- Translation (optional). Raises MyMemory's free quota; sent to MyMemory as `de`.
MYMEMORY_EMAIL=

# --- WebRTC TURN (optional but needed for calls across mobile networks / CGNAT).
# Comma-separated URLs. These are visible in the browser by design.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# --- Demo aids. true enables ?testRegion=KL&testHour=11&testWatchLimit=20 (always
# labelled on screen). Lets anyone spoof region/time: turn off when not demoing.
NEXT_PUBLIC_ENABLE_TEST_OVERRIDES=false

# --- Public URL of the deployment, e.g. https://yourtube.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Test-only, never set in a deployment:
# NEXT_PUBLIC_USE_EMULATORS=true   point the browser app at the Firebase emulators
# MAIL_CAPTURE_DIR=./mail          write emails to disk instead of sending them
