{
  "name": "yourtube",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-yourtube 'vitest run -c vitest.rules.config.mts'",
    "test:api": "firebase emulators:exec --only auth,firestore --project demo-yourtube 'vitest run -c vitest.api.config.mts'",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-yourtube 'playwright test -c playwright.emulator.config.ts'",
    "test:smoke": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/functions": "^3.9.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.513.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "firebase-tools": "^15.32.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
